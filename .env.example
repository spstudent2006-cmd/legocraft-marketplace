PORT=3000
# Change this in production - used to sign session tokens
SESSION_SECRET=change-this-to-a-long-random-string

# Optional. Only needed for the "Analyze with AI (photo)" and
# "Speak product details" (voice) buttons in the seller dashboard's
# Add Product form. Get a free key at https://aistudio.google.com/apikey
# Leave blank to disable those two features - everything else in the app
# works fine without it.
GEMINI_API_KEY=
